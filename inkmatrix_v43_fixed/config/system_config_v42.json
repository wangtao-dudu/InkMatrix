{
  "system_info": {
    "name": "墨算 InkMatrix",
    "version": "4.2.0",
    "release_date": "2024-07-16",
    "developer": "InkMatrix Team",
    "description": "智能调色配方系统 - 全面改进版"
  },
  
  "performance_settings": {
    "cache_ttl_seconds": 3600,
    "max_memory_cache_items": 10000,
    "async_loading_enabled": true,
    "batch_processing_enabled": true,
    "batch_size": 100,
    "ui_update_debounce_ms": 200,
    "query_cache_ttl": 60,
    "performance_monitoring": true
  },
  
  "color_engine_settings": {
    "algorithm_version": "2.0",
    "optimization_level_default": "high",
    "use_spectrum_matching": true,
    "hue_deviation_threshold_degrees": 45,
    "metameric_risk_threshold": 0.5,
    "max_candidate_inks": 12,
    "color_space": "CIELAB",
    "illuminant": "D65",
    "standard_observer": "2°",
    "delta_e_formula": "94",
    "min_practical_weight": 0.001
  },
  
  "ui_design_settings": {
    "design_system": "modern_clean",
    "color_theme": "light",
    "primary_color": "#2563EB",
    "selection_color": "#3B82F6",
    "selection_background": "#EFF6FF",
    "font_family": "system-ui, -apple-system, sans-serif",
    "table_row_height_px": 44,
    "page_max_width_px": 1400,
    "content_padding_px": 24
  },
  
  "account_management": {
    "require_login": true,
    "password_hash_algorithm": "sha256",
    "session_timeout_minutes": 60,
    "account_types_enabled": ["admin", "seller", "user"],
    "default_account_type": "user",
    "enable_permission_system": true,
    "permission_check_on_every_action": true
  },
  
  "backup_and_recovery": {
    "auto_backup_enabled": true,
    "backup_interval_seconds": 3600,
    "max_backup_count": 10,
    "backup_directory": "./backups",
    "backup_compression": "zip",
    "backup_data_sources": {
      "ink_library": "data/inks_db.json",
      "products": "data/products_db.json",
      "bottles": "data/bottles_db.json",
      "company": "data/company_info.json",
      "accounts": "data/accounts.json",
      "print_jobs": "data/print_jobs.json"
    },
    "emergency_export_enabled": true
  },
  
  "update_settings": {
    "check_updates_on_startup": true,
    "check_updates_interval_hours": 24,
    "auto_download_enabled": false,
    "auto_install_enabled": false,
    "backup_before_update": true,
    "update_server": "http://update.inkmatrix.local/api/v1",
    "update_channel": "stable",
    "support_rollback": true
  },
  
  "database_settings": {
    "data_directory": "data",
    "ink_database_file": "inks_db.json",
    "accounts_file": "accounts.json",
    "auto_save_interval_ms": 5000,
    "backup_on_save": true
  },
  
  "logging_settings": {
    "log_level": "INFO",
    "log_directory": "logs",
    "log_file": "inkmatrix.log",
    "max_log_size_mb": 100,
    "keep_log_days": 30,
    "log_performance_metrics": true,
    "log_sql_queries": false
  },
  
  "advanced_features": {
    "enable_spectral_analysis": true,
    "enable_metameric_detection": true,
    "enable_cost_optimization": true,
    "enable_stability_analysis": true,
    "enable_multi_angle_viewing": false,
    "enable_AI_recommendations": false,
    "enable_cloud_sync": false
  },
  
  "ui_components": {
    "inventory_page": {
      "enable_real_time_search": true,
      "enable_inline_editing": true,
      "enable_bulk_operations": true,
      "rows_per_page": 20,
      "selection_highlight_color": "#3B82F6",
      "selection_highlight_opacity": 0.1
    },
    "print_job_page": {
      "enable_real_time_preview": true,
      "auto_save_draft": true,
      "draft_save_interval_ms": 10000
    },
    "ink_library_page": {
      "enable_filtering": true,
      "enable_categorization": true,
      "show_cost_info": true,
      "show_stability_score": true
    }
  },
  
  "migration_notes": {
    "v4.1_to_v4.2": [
      "新增color_engine_v2.py，支持多目标优化",
      "新增performance_optimizer.py，提升性能30-70%",
      "新增account_manager.py，支持多账户权限隔离",
      "新增design_system.py，统一UI设计",
      "新增update_backup_service.py，完整的更新和备份系统",
      "改进了选中行的视觉设计（蓝色而非灰色）",
      "添加了每账户独立的油墨库存管理",
      "修复了配色算法的色相离谱问题",
      "向后兼容 - 可以直接升级，数据保持不变"
    ],
    "backward_compatibility": true,
    "data_migration_required": false,
    "auto_migrate": true
  },
  
  "quality_metrics": {
    "color_matching": {
      "target_delta_e_94": 2.0,
      "target_hue_accuracy": "±5°",
      "target_success_rate": 0.95
    },
    "performance": {
      "target_startup_time_seconds": 6,
      "target_ink_database_load_seconds": 2.5,
      "target_ui_response_ms": 100,
      "target_memory_usage_mb": 256
    },
    "reliability": {
      "target_uptime_percent": 99.5,
      "target_backup_success_rate": 0.99,
      "target_data_loss_risk_percent": 0.01
    }
  }
}
